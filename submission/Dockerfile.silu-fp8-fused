FROM misokaio/ghfjdk:v0.25.1-lfm25-fused@sha256:53d1892ca842ffa2f5e3113f0f775450701bacb7c014d8f497bd63e6ad61d401

ENV VLLM_LFM25_FUSED_SILU_FP8=1

COPY apply_lfm25_silu_fp8_fusion.py /tmp/apply_lfm25_silu_fp8_fusion.py
COPY lfm25_fused_silu_fp8.py /tmp/lfm25_fused_silu_fp8.py
COPY test_lfm25_fused_silu_fp8.py /opt/lfm25/test_lfm25_fused_silu_fp8.py

RUN python3 /tmp/apply_lfm25_silu_fp8_fusion.py \
      --kernel-source /tmp/lfm25_fused_silu_fp8.py \
    && python3 -m py_compile \
      /tmp/apply_lfm25_silu_fp8_fusion.py \
      /tmp/lfm25_fused_silu_fp8.py \
      /opt/lfm25/test_lfm25_fused_silu_fp8.py \
    && rm -f \
      /tmp/apply_lfm25_silu_fp8_fusion.py \
      /tmp/lfm25_fused_silu_fp8.py
