# syntax=docker/dockerfile:1.7

FROM python:3.12-slim AS fastokens

RUN python3 -m pip install \
      --target=/fastokens \
      --no-cache-dir \
      --disable-pip-version-check \
      --only-binary=:all: \
      fastokens==0.2.0 \
    && PYTHONPATH=/fastokens python3 -c \
      "import importlib.metadata as m, fastokens; assert m.version('fastokens') == '0.2.0'; print('fastokens installed:', fastokens.__file__)"

FROM scratch AS fastokens-layer

COPY --from=fastokens /fastokens/ /usr/local/lib/python3.12/dist-packages/

FROM vinhdq17/vllm_openai:v0.4.0

# fastokens must be installed at image-build time because the grader has no
# network access while the serving container is running.
COPY --from=fastokens /fastokens/ /usr/local/lib/python3.12/dist-packages/

LABEL org.opencontainers.image.version="v0.25.1.1" \
      org.opencontainers.image.base.name="docker.io/vinhdq17/vllm_openai:v0.4.0" \
      org.opencontainers.image.description="vinhdq17/vllm_openai:v0.4.0 with fastokens 0.2.0"
